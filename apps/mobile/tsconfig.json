{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": [
      "react",
      "react-native",
      "node",
      "bun",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
