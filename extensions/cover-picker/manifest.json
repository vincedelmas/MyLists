{
    "version": "1.1.1",
    "manifest_version": 3,
    "name": "MyLists Cover Picker",
    "minimum_chrome_version": "102",
    "description": "Right-click an image from a MyLists cover search to fill a MyLists cover form.",
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "MyLists Cover Picker"
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost/*",
                "http://127.0.0.1/*",
                "https://mylists.info/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mylists.info/*"
    ]
}
