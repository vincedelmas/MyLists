{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "tags": [
        "-lintignore"
    ],
    "entry": [
        "server.ts",
        "src/styles.css",
        "src/routeTree.gen.ts",
        "src/routes/**/*.{ts,tsx}"
    ],
    "project": [
        "src/**/*.{ts,tsx,css}"
    ],
    "vite": {
        "config": [
            "vite.config.ts",
            "vite.cli.config.ts"
        ]
    },
    "ignoreDependencies": [
        "@fontsource/fira-sans-condensed",
        "@fontsource/open-sans",
        "@fontsource/source-serif-4",
        "@fontsource-variable/noto-emoji",
        "@fontsource-variable/noto-sans-jp",
        "pino-pretty"
    ],
    "ignoreBinaries": [
        "flock"
    ],
    "ignoreIssues": {
        "src/lib/client/components/ui/**": [
            "exports"
        ]
    }
}
