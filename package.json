{
    "name": "mylists",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "knip": "knip-bun",
        "dk": "bun scripts/dk.ts",
        "ui": "bunx shadcn@latest",
        "typecheck": "tsc --noEmit",
        "test": "bun run --bun vitest run",
        "dev": "bun --bun vite dev --port 3000",
        "cli": "bun --env-file=.env src/cli/index.ts",
        "test:e2e": "bun --no-env-file scripts/e2e/run.ts",
        "email": "email dev -d src/lib/client/components/emails",
        "routes:generate": "bun --no-env-file scripts/generate-routes.ts",
        "new:db": "mkdir -p instance && bun run dk migrate && bun run cli -- seed-achievements",
        "dev:user": "bun run cli -- create-user --email browser@example.invalid --password BrowserDevPassword! --username browserdev --role user",
        "auth:generate": "bunx --bun auth@1.7.25 generate --yes --config src/lib/server/core/auth.ts --output src/lib/server/database/schema/auth.schema.ts",
        "build": "bun --bun vite build && bun --bun vite build --config vite.cli.config.ts && bun build ./server.ts --target=bun --outfile=./dist/server.js"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@better-auth/mcp": "1.7.25",
        "@better-auth/oauth-provider": "1.7.25",
        "@fontsource-variable/noto-emoji": "5.3.2",
        "@fontsource-variable/noto-sans-jp": "5.3.1",
        "@fontsource/open-sans": "5.3.0",
        "@hookform/resolvers": "^7.0.7",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@react-email/components": "1.0.12",
        "@react-email/render": "^2.3.1",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/charts": "^1.5.0",
        "@tanstack/react-query": "^5.108.0",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-start": "^1.169.5",
        "@tanstack/react-store": "^0.11.2",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26",
        "@tanstack/router-core": "1.171.39",
        "@tanstack/router-ssr-query-core": "^1.169.3",
        "bcrypt": "^6.0.0",
        "better-auth": "1.7.25",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "commander": "^15.1.0",
        "csv-parse": "^7.0.3",
        "dedent": "^1.7.2",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "ioredis": "^6.0.0",
        "ipaddr.js": "^2.5.0",
        "jose": "6.2.17",
        "lucide-react": "^1.75.0",
        "nodemailer": "^10.6.0",
        "nprogress": "^0.2.0",
        "pino": "^10.4.0",
        "posthog-js-lite": "^4.14.0",
        "rate-limiter-flexible": "^11.5.0",
        "react": "19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.1",
        "react-easy-crop": "^6.2.5",
        "react-hook-form": "^7.92.0",
        "react-icons": "^5.7.0",
        "rotating-file-stream": "^4.0.0",
        "sqlite3-parser": "0.7.1",
        "takumi-js": "^2.20.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.1.2",
        "@playwright/test": "1.65.1",
        "@react-email/ui": "6.11.16",
        "@rolldown/plugin-babel": "^0.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query-devtools": "^5.108.0",
        "@tanstack/router-generator": "1.168.0",
        "@types/babel__core": "^7.20.5",
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
        "knip": "^6.45.1",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "pino-pretty": "^13.2.0",
        "react-email": "6.11.16",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-react-click-to-component": "^4.3.0",
        "vitest": "^5.1.1"
    }
}
