{
    "name": "mylists",
    "private": true,
    "type": "module",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "knip": "knip-bun",
        "dk": "drizzle-kit",
        "ui": "bunx shadcn@latest",
        "typecheck": "tsc --noEmit",
        "test": "bun run --bun vitest run",
        "preview": "bun --bun vite preview",
        "test:watch": "bun run --bun vitest",
        "build:server": "bun --bun vite build",
        "cli:docker": "bun ./dist/cli/index.js",
        "dev": "bun --bun vite dev --port 3000",
        "cli": "bun --env-file=.env src/cli/index.ts",
        "test:e2e": "bun --no-env-file scripts/e2e/run.ts",
        "seed:achievements": "bun run cli -- seed-achievements",
        "email": "email dev -d src/lib/client/components/emails",
        "build:cli": "bun --bun vite build --config vite.cli.config.ts",
        "routes:generate": "bun --no-env-file scripts/generate-routes.ts",
        "build": "bun run build:server && bun run build:cli && bun run build:entry",
        "build:entry": "bun build ./server.ts --target=bun --outfile=./dist/server.js",
        "new:db": "mkdir -p instance && bun run dk push --force && bun run seed:achievements",
        "new:db:docker": "mkdir -p instance && bun run dk push --force && bun run cli:docker -- seed-achievements",
        "dev:user": "bun run cli -- create-user --email browser@example.invalid --password BrowserDevPassword! --username browserdev --role user",
        "auth:generate": "bunx --bun auth@1.7.7 generate --yes --config src/lib/server/core/auth.ts --output src/lib/server/database/schema/auth.schema.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@better-auth/mcp": "1.7.7",
        "@better-auth/oauth-provider": "1.7.7",
        "@fontsource-variable/noto-emoji": "5.3.2",
        "@fontsource-variable/noto-sans-jp": "5.3.1",
        "@fontsource/open-sans": "5.3.0",
        "@hookform/resolvers": "^5.9.2",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/sdk": "1.32.1",
        "@react-email/components": "1.0.12",
        "@react-email/render": "^2.1.1",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/charts": "^1.1.0",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-start": "^1.169.4",
        "@tanstack/react-store": "^0.11.2",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.22",
        "@tanstack/router-core": "1.171.39",
        "@tanstack/router-ssr-query-core": "^1.169.3",
        "bcrypt": "^6.0.0",
        "better-auth": "1.7.7",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "commander": "^15.0.0",
        "csv-parse": "^7.0.3",
        "dedent": "^1.7.2",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "drizzle-zod": "^0.8.3",
        "ioredis": "^6.0.0",
        "ipaddr.js": "^2.5.0",
        "jose": "6.2.12",
        "lucide-react": "^1.61.0",
        "nodemailer": "^10.2.1",
        "nprogress": "^0.2.0",
        "pino": "^10.4.0",
        "posthog-js": "^1.438.21",
        "rate-limiter-flexible": "^11.2.3",
        "react": "19.3.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.0",
        "react-easy-crop": "^6.2.4",
        "react-hook-form": "^7.91.0",
        "react-icons": "^5.7.0",
        "sqlite3-parser": "0.7.1",
        "takumi-js": "^2.17.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.0.9",
        "@playwright/test": "1.64.0",
        "@react-email/ui": "6.11.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@tanstack/router-generator": "1.167.41",
        "@types/babel__core": "^7.20.5",
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
        "knip": "^6.43.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "pino-pretty": "^13.2.0",
        "react-email": "6.11.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vite-plugin-react-click-to-component": "^4.2.3",
        "vitest": "^5.0.5"
    }
}
